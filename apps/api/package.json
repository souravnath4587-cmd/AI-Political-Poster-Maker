{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "templates:thumbnails": "tsx scripts/build-thumbnails.ts",
    "seed:templates": "tsx scripts/seed-templates.ts",
    "test": "vitest run",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "cloudinary": "^2.11.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
