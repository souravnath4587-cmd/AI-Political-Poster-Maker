{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{assets/**,dist/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
