NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Frontend origin (the Vercel URL in production)
APP_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/poster-maker?retryWrites=true&w=majority

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
