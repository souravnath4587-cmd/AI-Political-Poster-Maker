NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Frontend origin (the Vercel URL in production)
APP_ORIGIN=http://localhost:3000

# Local: `pnpm dev:db` starts MongoDB on this port. Production: MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=poster-maker
# Only if Node fails with "querySrv ECONNREFUSED" on mongodb+srv:// URIs (local DNS proxy/VPN):
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Cloudinary (Dashboard -> API Keys). Optional in development until Phase 4; required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Puppeteer rendering
RENDER_CONCURRENCY=1
CHROME_NO_SANDBOX=false

# Auth
SESSION_TTL_DAYS=30
# Required in production (16+ random characters)
OTP_PEPPER=
# Log codes and return them as devCode instead of sending SMS (local/demo only)
OTP_DEV_MODE=true
# Reviewer logins with a fixed code, no SMS (run `pnpm --filter @app/api seed:users`)
REVIEWER_FREE_PHONE=01999000001
REVIEWER_PREMIUM_PHONE=01999000002
REVIEWER_CODE=123456

# Gemini (optional): face-aware photo cropping and headline suggestions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
